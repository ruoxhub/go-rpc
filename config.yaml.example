# Rpc Server Configuration

# Basic listen configuration
# Format: host:port or :port (binds to all interfaces)
BasicListen: ":5612"

# Alternatively, specify host and port separately
Host: "0.0.0.0"
Port: 5612

# Default timeout for RPC calls in seconds
DefaultTimeOut: 30

# Enable or disable logging
CloseLog: true

# Enable or disable web access logging
CloseWebLog: true

# Running mode: debug or release
Mode: release

# Enable CORS (Cross-Origin Resource Sharing)
Cors: true

# Disable web admin panel and /api routes (minimal RPC-only mode)
DisableWebAdmin: true

# Disable metrics collection (no DB writes to metric tables)
DisableMetrics: true

# Disable alert evaluation engine
DisableAlert: true

# Disable PostgreSQL entirely (DB-less mode, skips migration and DB-dependent routes)
DisableDatabase: true

# HTTPS configuration (optional)
HttpsServices:
  IsEnable: false
  HttpsListen: ":5643"
  PemPath: "certs/server.pem"
  KeyPath: "certs/server.key"

# Route prefix replacement (optional)
# Useful when deploying behind a reverse proxy
RouterReplace:
  IsEnable: true
  ReplaceRoute: "/sekiro"

# Database configuration
Database:
  Host: "localhost"
  Port: 5432
  User: "postgres"
  Password: "postgres"
  DBName: "sekiro"
  SSLMode: "disable"
