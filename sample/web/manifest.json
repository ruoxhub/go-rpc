{
  "manifest_version": 3,
  "name": "Browser RPC",
  "version": "3.1.0",
  "description": "Extract data from social media platforms via WebSocket RPC",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "declarativeNetRequest",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "958722251@qq.com",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "world": "ISOLATED",
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge/bridge.js"
      ],
      "run_at": "document_start"
    },
