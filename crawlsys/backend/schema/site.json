{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SiteSource",
    "description": "站点来源模型",
    "type": "object",
    "properties": {
        "bs_siteid": {"type": "integer", "description": "站点 id"},
        "bs_sitename": {"type": "string", "maxLength": 100, "description": "站点名称"},
        "bs_industryid": {"type": "integer", "description": "行业分类 id"},
        "bs_mediaid": {"type": "integer", "description": "媒体类型 id"},
        "bs_countryid": {"type": "integer", "description": "国家 id"},
        "bs_languageid": {"type": "integer", "description": "语种 id"},
        "bs_url": {"type": "string", "maxLength": 2048, "description": "url"},
        "bs_status": {"type": "string", "maxLength": 1, "description": "状态"},
        "bs_weigth": {"type": "integer", "description": "权重 (列名为历史拼写，应用层使用 bs_weight)"},
        "bs_modifystatus": {"type": "string", "maxLength": 1, "description": "可修改状态"},
        "bs_remark": {"type": "string", "description": "备注"},
        "bs_errtype": {"type": "integer", "description": "站点错误描述"},
        "bs_isproxy": {"type": "integer", "enum": [1, 2], "description": "是否需要代理 1：需要 2：不需要"},
        "bs_down_type": {"type": "integer", "default": 1, "description": "下载类型"},
        "bs_instock": {"type": "string", "maxLength": 1, "default": "0", "description": "是否入库"},
        "dept": {"type": "string", "maxLength": 255, "description": "部门"},
        "bs_cralwer_commnet": {"type": "string", "maxLength": 1, "enum": ["0", "1"], "description": "采集评论（1:是，0:否）(列名为历史拼写，应用层使用 bs_crawler_comment)"},
        "bs_cralwer_level": {"type": "string", "maxLength": 1, "enum": ["1", "2", "3"], "description": "层级（1:一级，2:二级，3:三级）(列名为历史拼写，应用层使用 bs_crawler_level)"},
        "bs_keywords": {"type": "string", "description": "关键词"},
        "create_by": {"type": "string", "maxLength": 100, "description": "创建人"},
        "create_time": {"type": "string", "format": "date-time", "description": "创建时间"},
        "is_downall": {"type": "integer", "enum": [0, 1, 2], "default": 0, "description": "下载策略：0:不下载，1:下载所有，2:仅图片附件"},
        "bs_browser_type": {"type": "integer", "enum": [1, 2], "default": 1, "description": "浏览器类型（1：chrome; 2：firefox）"},
        "bs_web_id": {"type": "integer", "description": "t_busi_web id"},
        "bs_language_code": {"type": "string", "maxLength": 10, "description": "语种代码"},
        "bs_max_reach_page": {"type": "integer", "description": "最大实际翻页数"},
        "bs_last_all_item_time": {"type": "string", "format": "date-time", "description": "最新采集到列表的时间"},
        "bs_last_un_item_time": {"type": "string", "format": "date-time", "description": "最新采集到列表的时间"},
        "bs_reaource_type": {"type": "string", "maxLength": 500, "description": "资源类型，字典类型 resourceTypeDict（多个以，隔开）(列名为历史拼写，应用层使用 bs_resource_type)"},
        "bs_display_type": {"type": "string", "maxLength": 100, "description": "采集数据显示类型"},
        "bs_site_code": {"type": "string", "maxLength": 100, "description": "网站代码"},
        "bs_ico_url": {"type": "string", "maxLength": 512, "description": "网站图标 URL"},
        "bs_desc": {"type": "string", "description": "网站介绍"},
    },
    "required": ["bs_siteid"],
}