{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Media",
    "description": "媒体模型",
    "type": "object",
    "properties": {
        "id": {"type": "integer", "description": "主键 ID"},
        "datatype": {"type": "string", "maxLength": 10, "default": "0", "description": "数据类型"},
        "created_time": {"type": "string", "format": "date-time", "description": "系统创建时间"},
        "updated_time": {"type": "string", "format": "date-time", "description": "系统更新时间"},
        "media_id": {"type": "string", "maxLength": 32, "description": "媒体 ID"},
        "user_id": {"type": "string", "maxLength": 64, "description": "用户 ID"},
        "content_id": {"type": "string", "maxLength": 64, "description": "视频 ID"},
        "type": {"type": "integer", "enum": [1, 2, 3, 4], "description": "1:video 2:photo 3:gif 4:audio"},
        "url": {"type": "string", "maxLength": 1024, "description": "网页地址"},
        "platform": {"type": "string", "maxLength": 50, "description": "所属平台"},
        "pub_time": {"type": "string", "format": "date-time", "description": "发布时间"},
        "extend": {"type": "string", "description": "扩展字段 (JSON 字符串)"}
    },
    "required": ["id"],
}
