{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Content",
    "description": "内容模型 - 融合文章/视频/帖子数据",
    "type": "object",
    "properties": {
        "id": {"type": "integer", "description": "主键 ID"},
        "datatype": {"type": "string", "maxLength": 10, "default": "0", "description": "数据类型"},
        "created_time": {"type": "string", "format": "date-time", "description": "系统创建时间"},
        "updated_time": {"type": "string", "format": "date-time", "description": "系统更新时间"},
        "content_id": {"type": "string", "maxLength": 64, "description": "平台内容 ID"},
        "user_id": {"type": "string", "maxLength": 64, "description": "平台用户 ID"},
        "author": {"type": "string", "maxLength": 255, "description": "作者"},
        "pic": {"type": "string", "maxLength": 512, "description": "封面"},
        "thumbnail": {"type": "string", "maxLength": 512, "description": "视频封面"},
        "title": {"type": "string", "maxLength": 512, "description": "标题"},
        "content": {"type": "string", "description": "内容"},
        "description": {"type": "string", "description": "简介"},
        "url": {"type": "string", "maxLength": 1024, "description": "链接"},
        "duration": {"type": "integer", "description": "时长"},
        "pub_time": {"type": "string", "format": "date-time", "description": "发布时间"},
        "download_time": {"type": "string", "format": "date-time", "description": "下载时间"},
        "dispose_time": {"type": "string", "format": "date-time", "description": "处理时间"},
        "location": {"type": "string", "maxLength": 255, "description": "位置"},
        "share_count": {"type": "integer", "default": 0, "description": "分享数"},
        "repost_count": {"type": "integer", "default": 0, "description": "转发数"},
        "comment_count": {"type": "integer", "default": 0, "description": "评论数"},
        "like_count": {"type": "integer", "default": 0, "description": "爱心数"},
        "view_count": {"type": "integer", "default": 0, "description": "播放数"},
        "favorites": {"type": "integer", "default": 0, "description": "收藏数"},
        "category_id": {"type": "integer", "description": "分类 ID"},
        "source_id": {"type": "integer", "description": "数据源 ID"},
        "source": {"type": "string", "maxLength": 255, "description": "数据源名称"},
        "platform": {"type": "string", "maxLength": 50, "description": "所属平台"},
        "data_type": {"type": "string", "maxLength": 10, "description": "数据类型 1:新闻 2:社交 3:视频 4:文章"},
        "extend": {"type": "string", "description": "扩展字段 (JSON 字符串)"},
    },
    "required": ["id"],
}