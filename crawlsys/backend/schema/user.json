{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "User",
    "description": "用户模型",
    "type": "object",
    "properties": {
        "id": {"type": "integer", "description": "主键 ID"},
        "datatype": {"type": "string", "maxLength": 10, "default": "0", "description": "数据类型"},
        "created_time": {"type": "string", "format": "date-time", "description": "系统创建时间"},
        "updated_time": {"type": "string", "format": "date-time", "description": "系统更新时间"},
        "avatar": {"type": "string", "maxLength": 255, "description": "用户头像地址"},
        "name": {"type": "string", "maxLength": 255, "description": "名称"},
        "username": {"type": "string", "maxLength": 255, "description": "用户名"},
        "gender": {"type": "integer", "enum": [0, 1, 2], "default": 0, "description": "性别 0: 无 1: 男 2：女"},
        "email": {"type": "string", "maxLength": 500, "description": "邮箱"},
        "phone": {"type": "string", "maxLength": 500, "description": "手机号"},
        "website": {"type": "string", "maxLength": 500, "description": "个人网站"},
        "description": {"type": "string", "description": "用户描述"},
        "education": {"type": "string", "description": "教育经历"},
        "experience": {"type": "string", "description": "工作经验"},
        "location": {"type": "string", "maxLength": 255, "description": "位置"},
        "city": {"type": "string", "maxLength": 100, "description": "城市"},
        "country_code": {"type": "string", "maxLength": 10, "description": "国家代码"},
        "follower_count": {"type": "integer", "default": 0, "description": "粉丝数"},
        "following_count": {"type": "integer", "default": 0, "description": "关注数"},
        "content_count": {"type": "integer", "default": 0, "description": "内容数 (包括贴子、文章、视频)"},
        "birthday": {"type": "string", "maxLength": 20, "description": "生日"},
        "verified": {"type": "string", "maxLength": 255, "description": "平台认证"},
        "extend": {"type": "string", "description": "扩展字段 (JSON 字符串)"},
        "platform": {"type": "string", "maxLength": 50, "description": "所属平台"},
        "created_at": {"type": "string", "format": "date-time", "description": "平台注册时间（不要与 created_time 系统创建时间混淆）"},
    },
    "required": ["id"],
}
