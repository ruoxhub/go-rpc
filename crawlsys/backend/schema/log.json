{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "BusTaskLog",
    "description": "任务日志模型",
    "type": "object",
    "properties": {
        "btl_id": {"type": "integer", "description": "主键 ID"},
        "btl_taskid": {"type": "integer", "description": "任务 id"},
        "btl_websiteid": {"type": "integer", "description": "站点 id"},
        "btl_node_id": {"type": "integer", "description": "节点 id"},
        "btl_start_time": {"type": "string", "format": "date-time", "description": "任务执行时间"},
        "btl_end_time": {"type": "string", "format": "date-time", "description": "结束时间"},
        "btl_item_num": {"type": "integer", "default": 0, "description": "识别数量"},
        "btl_consue_time": {"type": "integer", "default": 0, "description": "耗时（毫秒）(列名为历史拼写，应用层使用 btl_consume_time)"},
        "btl_pageturn_num": {"type": "integer", "default": 0, "description": "翻页数量"},
        "btl_collect_num": {"type": "integer", "default": 0, "description": "采集数量"},
        "btl_runtime_efficiency": {"type": "integer", "default": 0, "description": "执行效率"},
        "btl_err_num": {"type": "integer", "default": 0, "description": "异常数量"},
        "btl_all_item_num": {"type": "integer", "default": 0, "description": "所有数量"},
        "btl_request_rate": {"type": "integer", "default": 5, "description": "请求频率"},
        "btl_status": {"type": "integer", "enum": [-1, 0, 1], "default": 0, "description": "异常状态，1 正常，-1 异常"},
        "btl_uuid": {"type": "string", "maxLength": 36, "description": "页面唯一 id"},
        "btl_err_msg": {"type": "string", "description": "异常信息"},
        "btl_msg": {"type": "string", "description": "日志信息"},
    },
    "required": ["btl_id", "btl_taskid"],
}