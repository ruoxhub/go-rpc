{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Comment",
    "description": "评论模型",
    "type": "object",
    "properties": {
        "id": {"type": "integer", "description": "主键 ID"},
        "datatype": {"type": "string", "maxLength": 10, "default": "0", "description": "数据类型"},
        "created_time": {"type": "string", "format": "date-time", "description": "系统创建时间"},
        "updated_time": {"type": "string", "format": "date-time", "description": "系统更新时间"},
        "content_id": {"type": "string", "maxLength": 255, "description": "评论所在的内容关联 id"},
        "parent_user_id": {"type": "string", "maxLength": 64, "description": "上级用户 id"},
        "parent_name": {"type": "string", "maxLength": 255, "description": "上级用户名"},
        "parent_comment_id": {"type": "string", "maxLength": 64, "description": "上级评论 id"},
        "user_id": {"type": "string", "maxLength": 64, "description": "评论的用户 id"},
        "username": {"type": "string", "maxLength": 255, "description": "用户名"},
        "comment_id": {"type": "string", "maxLength": 64, "description": "评论 id"},
        "content": {"type": "string", "description": "评论帖子的内容"},
        "like_count": {"type": "integer", "default": 0, "description": "爱心数"},
        "reply_count": {"type": "integer", "default": 0, "description": "回复数"},
        "pub_time": {"type": "string", "format": "date-time", "description": "发布时间"},
        "extend": {"type": "string", "description": "扩展字段 (JSON 字符串)"},
        "platform": {"type": "string", "maxLength": 50, "description": "所属平台"},
    },
    "required": ["id"],
}