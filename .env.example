# Local development only. Copy to .env; .env is ignored by git.
RPC_HOST=0.0.0.0
RPC_PORT=5612
RPC_MODE=debug

# Set true to run the core RPC routes without PostgreSQL.
RPC_DISABLE_DATABASE=true
RPC_DISABLE_METRICS=true
RPC_DISABLE_ALERT=true
RPC_DISABLE_TRACE=true

# For database-backed development, set RPC_DISABLE_DATABASE=false and replace
# these local-only values. Release mode rejects postgres/postgres.
RPC_DB_HOST=localhost
RPC_DB_PORT=5432
RPC_DB_USER=postgres
RPC_DB_PASSWORD=postgres
RPC_DB_NAME=sekiro
RPC_DB_SSL_MODE=disable

RPC_LOG_DIR=logs
RPC_LOG_FILENAME=rpc.log
