{
  "name": "@mrh30000/go-rpc-sdk",
  "version": "0.1.0-experimental.1",
  "type": "module",
  "files": ["dist/browser", "dist/src", "README.md"],
  "exports": {
    ".": {"types": "./dist/src/browser.d.ts", "import": "./dist/src/browser.js"},
