  },
  "dependencies": {"ws": "^8.18.0"},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
