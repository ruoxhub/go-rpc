# ===========================================
# RPC Server Configuration
# ===========================================

# Server
RPC_HOST=0.0.0.0
RPC_PORT=5612
RPC_MODE=debug
RPC_TIMEOUT=30

# Logging
RPC_CLOSE_LOG=false
RPC_CLOSE_WEB_LOG=false
RPC_LOG_DIR=logs
RPC_LOG_FILENAME=rpc.log
RPC_LOG_MAX_SIZE=100
RPC_LOG_MAX_BACKUPS=7
RPC_LOG_MAX_AGE=30
RPC_LOG_COMPRESS=true

# CORS
# SECURITY: Empty RPC_CORS_ORIGINS = deny all cross-origin requests.
# Use "*" to allow all origins (not recommended for production).
# Use comma-separated list for specific origins: http://example.com,http://localhost:3000
RPC_CORS=true
RPC_CORS_ORIGINS=*

# Feature toggles
RPC_DISABLE_WEB_ADMIN=false
RPC_DISABLE_METRICS=false
RPC_DISABLE_ALERT=false
RPC_DISABLE_DATABASE=false

# Protocol stage-1 handshake: enable so SDK ExecutorClient can negotiate the
# invocation_context.v1 capability and receive the 'registered' confirmation.
RPC_CAPABILITY_NEGOTIATION=true

# Route prefix replacement (reverse proxy)
RPC_ROUTE_REPLACE_ENABLE=false
# RPC_ROUTE_REPLACE_PREFIX=/sekiro

# HTTPS (optional)
RPC_HTTPS_ENABLE=false
RPC_HTTPS_LISTEN=:5643
# RPC_HTTPS_PEM_PATH=certs/server.pem
# RPC_HTTPS_KEY_PATH=certs/server.key

# Database (PostgreSQL)
RPC_DB_HOST=postgres-db
RPC_DB_PORT=5432
RPC_DB_USER=ruoxing
RPC_DB_PASSWORD=mrx123456
RPC_DB_NAME=rpc
RPC_DB_SSL_MODE=disable

# SMTP (alert email)
RPC_SMTP_HOST=localhost
RPC_SMTP_PORT=25
# RPC_SMTP_USERNAME=
# RPC_SMTP_PASSWORD=
RPC_SMTP_FROM=alert@sekiro.local
RPC_SMTP_USE_TLS=false

# Provider (Qwen)
RPC_PROVIDER_QWEN_TIMEOUT=120
RPC_PROVIDER_QWEN_LOG_CHUNKS=false

# Token extraction
# SECURITY: Query parameter tokens are deprecated (leaked in URL logs).
# Set to true only if legacy clients require it.
RPC_ALLOW_QUERY_TOKEN=false